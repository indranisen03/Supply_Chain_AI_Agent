# === LLM API Keys ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# === LangSmith Observability ===
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=stellantis-supply-chain

# === Application Settings ===
LOG_LEVEL=INFO
ENVIRONMENT=development

# === FastAPI ===
API_HOST=0.0.0.0
API_PORT=8000

# === Streamlit ===
STREAMLIT_PORT=8501

# === Cost Guardrail ===
MAX_COST_PER_RUN_USD=0.50

# === HITL Timeouts ===
SOFT_HITL_TIMEOUT_HOURS=12

# === Kaggle (optional — synthetic data used if absent) ===
